# Copy to .env.local for development. Production values live in Vercel → Environment Variables.

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Gmail sender (preferred): when both are set, notifications are sent from this
# Gmail account over SMTP instead of Resend. Use a Google "app password"
# (myaccount.google.com/apppasswords), never the account's real password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Resend — notifications go to the KORA team only (never to sponsors).
# Without a verified domain use SPONSOR_FROM_EMAIL=onboarding@resend.dev; Resend then
# delivers only to the address the Resend account was created with, so set
# SPONSOR_NOTIFY_TO to that address. Leave SPONSOR_NOTIFY_TO empty to use the KORA inbox.
# After verifying korakfupm.com it may list several inboxes: a@x.com,b@y.com
RESEND_API_KEY=
SPONSOR_FROM_EMAIL=
SPONSOR_NOTIFY_TO=
# Inboxes for speaker applications/nominations; empty → same as SPONSOR_NOTIFY_TO.
SPEAKERS_NOTIFY_TO=

# Long random string; salts the hashed visitor IP used for rate limiting
IP_HASH_SALT=

# Cloudflare Turnstile. The values below are Cloudflare's official
# always-pass TEST keys — for development only, never production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
